<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_only_form_view_wsct" model="ir.ui.view">
        <field name="name">product.template.form.wsct</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="WSCT / Factura T">
                    <group>
                        <field name="wsct_item_type"/>
                        <field name="wsct_tourism_catalog_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="wsct_tourism_code"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
